@model ProgIce2.Models.Claim
@{ ViewData["Title"] = "Submit a claim"; }

<div class="row justify-content-center"><div class="col-lg-8">
    <div class="d-flex justify-content-between align-items-end mb-4"><div><p class="eyebrow">New submission</p><h1 class="mb-1">Submit a bursary claim</h1><p class="text-secondary mb-0">Review the calculated amount before you submit.</p></div><a class="btn btn-link" asp-action="Index">My claims</a></div>
    <div class="card shadow-sm border-0"><div class="card-body p-4 p-md-5">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-md-6"><label asp-for="StudentNumber" class="form-label"></label><input asp-for="StudentNumber" class="form-control" /><span asp-validation-for="StudentNumber" class="text-danger"></span></div>
                <div class="col-md-6"><label asp-for="HoursWorked" class="form-label"></label><input asp-for="HoursWorked" class="form-control" min="0.01" step="0.01" id="hoursWorked" /><span asp-validation-for="HoursWorked" class="text-danger"></span></div>
                <div class="col-md-6"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName" class="text-danger"></span></div>
                <div class="col-md-6"><label asp-for="Surname" class="form-label"></label><input asp-for="Surname" class="form-control" /><span asp-validation-for="Surname" class="text-danger"></span></div>
            </div>
            <div class="calculation mt-4 p-4 rounded-3"><div><span class="text-secondary d-block small">Hourly rate</span><strong>R200.00</strong></div><div class="text-end"><span class="text-secondary d-block small">Calculated claim amount</span><strong id="claimTotal" class="fs-3">R0.00</strong></div></div>
            <input asp-for="HourlyRate" type="hidden" /><input asp-for="TotalClaimAmount" type="hidden" />
            <button class="btn btn-primary btn-lg mt-4" type="submit">Submit claim</button>
        </form>
    </div></div>
</div></div>

@section Scripts { <script>const hours=document.getElementById('hoursWorked'), total=document.getElementById('claimTotal'); function calculate(){const value=parseFloat(hours.value)||0;total.textContent='R'+(value*200).toLocaleString('en-ZA',{minimumFractionDigits:2,maximumFractionDigits:2});} hours.addEventListener('input',calculate);calculate();</script> }
