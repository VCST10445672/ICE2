@model ProgIce2.Models.ClaimSearchViewModel
@using ProgIce2.Models
@{ ViewData["Title"] = "My claims"; }

<div class="d-flex justify-content-between align-items-end mb-4"><div><p class="eyebrow">Claim history</p><h1 class="mb-1">My claims</h1><p class="text-secondary mb-0">Claims submitted within the previous 12 months.</p></div><a class="btn btn-primary" asp-action="Create">Submit a claim</a></div>
<div class="card border-0 shadow-sm mb-4"><div class="card-body p-4"><form method="get" class="row g-3 align-items-end"><div class="col-sm-8 col-lg-5"><label asp-for="StudentNumber" class="form-label"></label><input asp-for="StudentNumber" class="form-control" placeholder="e.g. STU123456" /></div><div class="col-sm-auto"><button class="btn btn-primary" type="submit">Search claims</button></div><div class="col-sm-auto"><a class="btn btn-outline-secondary" asp-action="Index">Clear</a></div></form></div></div>
@if (string.IsNullOrWhiteSpace(Model.StudentNumber)) { <div class="alert alert-info">Enter your student number to find your submitted claims. The table shows any claims from the last 12 months.</div> }
<div class="card border-0 shadow-sm overflow-hidden"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Claim ID</th><th>Date submitted</th><th>Hours</th><th>Hourly rate</th><th>Total amount</th><th>Status</th><th class="text-end">Action</th></tr></thead><tbody>
@if (Model.Claims.Count == 0) { <tr><td colspan="7" class="text-center text-secondary py-5">No claims were found for the previous 12 months.</td></tr> }
@foreach (var claim in Model.Claims) { <tr><td>#@claim.ClaimId</td><td>@claim.DateSubmitted.ToString("dd MMM yyyy")</td><td>@claim.HoursWorked.ToString("N2")</td><td>R@claim.HourlyRate.ToString("N2")</td><td class="fw-semibold">R@claim.TotalClaimAmount.ToString("N2")</td><td><span class="badge status-@claim.Status.ToString().ToLowerInvariant()">@claim.Status</span></td><td class="text-end">@if(claim.Status == ClaimStatus.Pending) { <form asp-action="Cancel" method="post" class="d-inline"><input type="hidden" name="id" value="@claim.ClaimId" /><input type="hidden" name="studentNumber" value="@Model.StudentNumber" /><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Cancel claim #@claim.ClaimId?');">Cancel</button></form> } else if(claim.Status == ClaimStatus.Approved) { <span class="small text-secondary">Cannot cancel</span> }</td></tr> }
</tbody></table></div></div>
